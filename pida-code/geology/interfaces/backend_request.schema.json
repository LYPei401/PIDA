{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pida.example/schemas/inversion-backend-request-v1.json",
  "title": "PIDA external inversion backend request",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "operation",
    "model_family",
    "method",
    "target",
    "deployment",
    "data",
    "runtime",
    "output_dir",
    "expected_result"
  ],
  "properties": {
    "schema": {"const": "pida.inversion-backend-request"},
    "schema_version": {"const": 1},
    "operation": {"enum": ["train_and_infer", "infer"]},
    "model_family": {"const": "InversionNet"},
    "method": {"enum": ["pida_one", "pida_logn", "full"]},
    "target": {"type": "string", "pattern": "^sim[0-9]+_t[0-9]+$"},
    "deployment": {
      "type": "object",
      "required": ["monitoring_range", "source_indices", "selected_receiver_count"],
      "properties": {
        "monitoring_range": {
          "type": "object",
          "required": ["start", "end"],
          "properties": {
            "start": {"type": "integer", "minimum": 0},
            "end": {"type": "integer", "minimum": 0}
          }
        },
        "source_indices": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 0},
          "uniqueItems": true
        },
        "selected_receiver_count": {"type": "integer", "minimum": 1}
      }
    },
    "data": {"type": "object"},
    "case_input": {"type": ["string", "null"]},
    "checkpoint": {"type": ["string", "null"]},
    "training": {"type": "object"},
    "runtime": {
      "type": "object",
      "required": ["device"],
      "properties": {"device": {"type": "string"}}
    },
    "output_dir": {"type": "string"},
    "expected_result": {"type": "string"}
  }
}
